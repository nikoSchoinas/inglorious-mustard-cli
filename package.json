{
  "name": "inglorious-mustard",
  "version": "0.1.0",
  "description": "The CLI for the M.U.S.T.A.R.D. planning method — it extracts your spec instead of asking for one.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mustard": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.25",
    "@ai-sdk/google": "^4.0.29",
    "@ai-sdk/openai": "^4.0.25",
    "@clack/prompts": "^1.7.0",
    "ai": "^7.0.44",
    "commander": "^12.1.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
